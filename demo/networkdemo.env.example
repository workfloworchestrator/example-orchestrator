# Settings for the HTTPS setup (demo/docker-compose.traefik.yml), see demo/HTTPS.md.
# Copy to demo/networkdemo.env (gitignored) and fill in every value.

# Services are published as gui., api., chat., netbox. and traefik.<DEMO_DOMAIN>
DEMO_DOMAIN=networkdemo.virge.io

# Let's Encrypt account; receives certificate expiry notices
ACME_EMAIL=
# Uncomment to test against the Let's Encrypt staging CA first (untrusted certs,
# generous rate limits). Remove the traefik-acme volume when switching back.
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Comma-separated CIDRs allowed to reach any of the hostnames; everyone else gets 403.
# Keep the host's own public IP and the docker ranges: server-side calls from
# containers to the public hostnames arrive from there.
ALLOWED_IPS=203.0.113.10/32,35.159.233.223/32,172.16.0.0/12

# Secrets: generate each with `openssl rand -hex 32` (CREDS_IV: `openssl rand -hex 16`)
NEXTAUTH_SECRET=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=

# NetBox 'admin' password; only used when NetBox creates the superuser on first start
NETBOX_ADMIN_PASSWORD=
