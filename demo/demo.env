# Compose settings for the network demo. Pass it together with the root .env
# (an explicit --env-file replaces the default one) to every compose command:
#   docker compose --env-file .env --env-file demo/demo.env up -d --wait
COMPOSE_PROFILES=lso,agents,network
LSO_ENABLED=True
PLANNER_INSTRUCTIONS=./demo/planner-agent/instructions.md
